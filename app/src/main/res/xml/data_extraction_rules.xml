<?xml version="1.0" encoding="utf-8"?>
<!--
  バックアップと端末間の移行の対象にしないもの
  - files/：HTTP キャッシュとサインイン情報（暗号化した DataStore）
  - サインイン情報の暗号鍵（Tink の鍵）。鍵の鍵は Android Keystore にあり、別の端末には移らないので、移しても復号できない
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="githubusers_auth_keyset.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="githubusers_auth_keyset.xml" />
    </device-transfer>
</data-extraction-rules>
